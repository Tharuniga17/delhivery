<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>kt telematics — Fleet &amp; Tyre Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0B1F2A;
    --ink-soft:#132C3A;
    --ink-soft2:#1B3B4C;
    --teal:#22B8A0;
    --teal-deep:#148C79;
    --teal-bright:#3FD9BE;
    --mint:#E7F7F2;
    --paper:#FBFDFC;
    --amber:#F2A93B;
    --slate:#5B6B72;
    --line:#D9E6E2;
    --max:1180px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,.wordmark{font-family:'Sora',sans-serif;}
  a{color:inherit;text-decoration:none;}
  img,svg{display:block;max-width:100%;}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 32px;}
  section{position:relative;}
 
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }
 
  /* ---------- NAV ---------- */
  header{
    position:fixed;top:0;left:0;right:0;z-index:200;
    padding:22px 0;
    background:linear-gradient(to bottom, rgba(11,31,42,0.9), rgba(11,31,42,0));
    transition:background .35s ease, padding .35s ease, box-shadow .35s ease;
  }
  header.solid{background:rgba(11,31,42,0.92);backdrop-filter:blur(8px);padding:14px 0;box-shadow:0 8px 24px -12px rgba(0,0,0,0.4);}
  header .wrap{display:flex;align-items:center;justify-content:space-between;}
  .wordmark{font-size:20px;font-weight:700;color:#fff;display:flex;align-items:baseline;gap:2px;letter-spacing:-0.01em;}
  .wordmark span{font-weight:400;color:var(--teal-bright);}
  nav.links{display:flex;gap:36px;align-items:center;}
  nav.links a{font-size:14.5px;color:rgba(255,255,255,0.82);font-weight:500;transition:color .2s;position:relative;}
  nav.links a::after{content:'';position:absolute;left:0;bottom:-5px;width:0;height:1.5px;background:var(--teal-bright);transition:width .25s ease;}
  nav.links a:hover{color:#fff;}
  nav.links a:hover::after{width:100%;}
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    padding:12px 26px;border-radius:8px;font-size:14.5px;font-weight:600;
    cursor:pointer;border:1px solid transparent;transition:transform .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-solid{background:linear-gradient(135deg,var(--teal),var(--teal-deep));color:#fff;box-shadow:0 8px 20px -8px rgba(34,184,160,0.6);}
  .btn-solid:hover{box-shadow:0 14px 26px -10px rgba(34,184,160,0.75);}
  .btn-ghost{border-color:rgba(255,255,255,0.35);color:#fff;}
  .btn-ghost:hover{border-color:#fff;background:rgba(255,255,255,0.06);}
 
  /* ---------- HERO ---------- */
  .hero{
    background:radial-gradient(120% 100% at 15% 0%, #16394A 0%, var(--ink) 55%);
    min-height:100vh;
    display:flex;flex-direction:column;justify-content:center;
    padding-top:110px;
    overflow:hidden;
    position:relative;
  }
  .hero-bg-shape{
    position:absolute;border-radius:50%;filter:blur(60px);opacity:0.14;pointer-events:none;
  }
  .shape-1{width:420px;height:420px;background:var(--teal-bright);top:-120px;right:-100px;}
  .shape-2{width:340px;height:340px;background:var(--amber);bottom:60px;left:-120px;opacity:0.08;}
 
  .hero .wrap{position:relative;z-index:3;}
  .hero-tag{
    display:inline-flex;align-items:center;gap:9px;
    font-size:13px;font-weight:500;color:var(--teal-bright);
    margin-bottom:22px;
  }
  .hero-tag .dot{width:7px;height:7px;border-radius:50%;background:var(--teal-bright);box-shadow:0 0 0 0 rgba(63,217,190,0.6);animation:pulse 2.2s infinite;}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(63,217,190,0.55);}
    70%{box-shadow:0 0 0 10px rgba(63,217,190,0);}
    100%{box-shadow:0 0 0 0 rgba(63,217,190,0);}
  }
  .hero h1{
    font-size:clamp(38px,5.4vw,66px);
    font-weight:700;
    color:#fff;
    letter-spacing:-0.02em;
    line-height:1.08;
    max-width:800px;
  }
  .hero h1 .line{display:block;overflow:hidden;}
  .hero h1 .line span{display:inline-block;}
  .hero p.sub{
    margin-top:26px;
    font-size:18px;
    color:rgba(255,255,255,0.68);
    max-width:520px;
  }
  .hero-ctas{display:flex;gap:16px;margin-top:38px;}
 
  /* floating badges in hero */
  .float-badge{
    position:absolute;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);
    backdrop-filter:blur(6px);border-radius:12px;padding:10px 14px;display:flex;align-items:center;gap:9px;
    font-size:12.5px;color:#fff;font-weight:500;z-index:3;opacity:0;
  }
  .badge-a{top:16%;right:6%;}
  .badge-b{top:42%;right:16%;}
  .badge-c{top:8%;left:2%;}
 
  .road-stage{
    position:relative;
    height:230px;
    margin-top:50px;
    z-index:2;
  }
  .road-line{
    position:absolute;left:0;right:0;bottom:64px;height:1px;
    background:linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.16) 15%, rgba(255,255,255,0.16) 85%, rgba(255,255,255,0) 100%);
  }
  .road-dashes{
    position:absolute;left:0;right:0;bottom:63px;height:3px;
    background:repeating-linear-gradient(90deg, rgba(63,217,190,0.55) 0 26px, transparent 26px 54px);
    background-size:80px 3px;
  }
  .bg-vehicle{position:absolute;bottom:2px;opacity:0.16;}
  #truck{position:absolute;bottom:0;left:-260px;width:230px;z-index:2;}
  .wheel{transform-origin:center;}
 
  /* ---------- MARQUEE ---------- */
  .marquee{background:var(--ink-soft);padding:16px 0;overflow:hidden;border-top:1px solid rgba(255,255,255,0.06);border-bottom:1px solid rgba(255,255,255,0.06);}
  .marquee-track{display:flex;align-items:center;width:max-content;gap:0;}
  .marquee-item{display:flex;align-items:center;gap:12px;padding:0 34px;color:rgba(255,255,255,0.55);font-size:13.5px;font-weight:600;letter-spacing:0.02em;white-space:nowrap;}
  .marquee-item svg{opacity:0.75;}
  .marquee-item .sep{width:5px;height:5px;border-radius:50%;background:var(--teal-bright);opacity:0.7;}
 
  /* ---------- STATS ---------- */
  .stats{background:var(--ink-soft);padding:64px 0;}
  .stats .wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .stat-card{text-align:center;display:flex;flex-direction:column;align-items:center;}
  .stat-gauge{width:74px;height:74px;margin-bottom:16px;}
  .stat-num{font-family:'Sora',sans-serif;font-size:clamp(28px,3.4vw,40px);font-weight:700;color:#fff;}
  .stat-label{font-size:13.5px;color:rgba(255,255,255,0.55);margin-top:6px;}
 
  /* ---------- SECTION HEADS ---------- */
  .kicker{font-size:13.5px;font-weight:600;color:var(--teal-deep);margin-bottom:14px;}
  .kicker.light{color:var(--teal-bright);}
  .section-head{max-width:600px;margin-bottom:56px;}
  .section-head h2{font-size:clamp(28px,3.4vw,38px);font-weight:700;letter-spacing:-0.015em;line-height:1.18;}
  .section-head p{margin-top:16px;font-size:16.5px;color:var(--slate);}
 
  /* ---------- CONVOY (pinned scroll scene) ---------- */
  .convoy-pin{background:var(--ink);height:100vh;overflow:hidden;position:relative;}
  .convoy-inner{position:relative;height:100%;display:flex;flex-direction:column;justify-content:center;}
  .convoy-heading{position:absolute;top:14%;left:0;right:0;text-align:center;z-index:5;}
  .convoy-heading .wrap{padding:0 32px;}
  .convoy-word{position:absolute;top:0;left:0;right:0;font-size:clamp(34px,6vw,72px);font-weight:800;color:#fff;letter-spacing:-0.02em;opacity:0;}
  .convoy-word span{color:var(--teal-bright);}
  .convoy-caption{position:absolute;bottom:14%;left:0;right:0;text-align:center;color:rgba(255,255,255,0.5);font-size:14.5px;z-index:5;}
  .convoy-road{position:absolute;bottom:14%;left:0;right:0;height:2px;background:rgba(255,255,255,0.12);}
  .convoy-dashes{position:absolute;bottom:calc(14% - 1px);left:0;right:0;height:4px;background:repeating-linear-gradient(90deg, var(--teal-bright) 0 30px, transparent 30px 64px);}
  .convoy-layer{position:absolute;bottom:14%;}
  .layer-far{opacity:0.35;filter:blur(0.4px);}
  .layer-mid{opacity:0.7;}
  .layer-near{opacity:1;}
 
  /* ---------- PRODUCTS ---------- */
  .products{padding:120px 0 110px;}
  .product-row{
    display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;
    padding:60px 0;
  }
  .product-row + .product-row{border-top:1px solid var(--line);}
  .product-row.reverse .art{order:2;}
  .product-row.reverse .copy{order:1;}
  .product-eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:16px;}
  .product-eyebrow .chip{
    font-size:12.5px;font-weight:600;color:var(--teal-deep);background:var(--mint);
    padding:5px 11px;border-radius:6px;
  }
  .copy h3{font-size:27px;font-weight:700;letter-spacing:-0.01em;margin-bottom:14px;}
  .copy p{color:var(--slate);font-size:15.5px;margin-bottom:22px;max-width:440px;}
  .feature-list{display:flex;flex-direction:column;gap:11px;}
  .feature-list li{list-style:none;display:flex;gap:10px;align-items:flex-start;font-size:14.5px;color:var(--ink);}
  .feature-list svg{flex-shrink:0;margin-top:3px;}
 
  .art{
    background:var(--mint);border-radius:20px;height:380px;
    display:flex;align-items:center;justify-content:center;
    position:relative;overflow:hidden;
    transition:transform .4s ease;
  }
  .art:hover{transform:translateY(-4px);}
  .art.dark{background:linear-gradient(160deg,#132C3A,#0B1F2A);}
  .art-inner{width:100%;height:100%;position:relative;}
 
  /* mini map styling */
  .minimap-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(34,184,160,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(34,184,160,0.08) 1px, transparent 1px);background-size:28px 28px;}
  .pin{position:absolute;transform:translate(-50%,-100%);}
  .pin-pulse{position:absolute;border-radius:50%;background:var(--teal);opacity:0.35;}
 
  /* gauge styling */
  .gauge-wrap{display:flex;flex-direction:column;align-items:center;gap:10px;}
  .gauge-value{font-family:'Sora',sans-serif;font-weight:700;font-size:15px;color:#fff;}
  .gauge-caption{font-size:11.5px;color:rgba(255,255,255,0.45);}
 
  /* ---------- FLOW ---------- */
  .flow{background:var(--mint);padding:120px 0;}
  .flow-track{position:relative;margin-top:76px;}
  .flow-path{position:relative;height:2px;background:var(--line);margin:0 60px;}
  .flow-path .fill{position:absolute;top:0;left:0;height:100%;width:0%;background:linear-gradient(90deg,var(--teal),var(--teal-bright));}
  .flow-vehicle{position:absolute;top:50%;left:0;width:34px;transform:translate(-50%,-58%);}
  .flow-steps{display:grid;grid-template-columns:repeat(3,1fr);margin-top:-14px;padding:0 60px;}
  .flow-step{text-align:center;padding-top:44px;position:relative;}
  .flow-step .node{
    position:absolute;top:0;left:50%;transform:translate(-50%,-50%);
    width:52px;height:52px;border-radius:50%;background:#fff;border:2px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    transition:border-color .3s, box-shadow .3s, transform .3s;
  }
  .flow-step.active .node{border-color:var(--teal);box-shadow:0 0 0 6px rgba(34,184,160,0.14);transform:translate(-50%,-50%) scale(1.08);}
  .flow-step h4{font-size:17px;font-weight:700;margin-bottom:8px;}
  .flow-step p{font-size:14px;color:var(--slate);max-width:230px;margin:0 auto;}
 
  /* ---------- LOGO STRIP ---------- */
  .trusted{padding:70px 0 0;text-align:center;}
  .trusted .kicker{margin-bottom:26px;}
  .logo-row{display:flex;justify-content:center;flex-wrap:wrap;gap:44px;opacity:0.55;}
  .logo-row span{font-family:'Sora',sans-serif;font-weight:700;font-size:18px;color:var(--slate);letter-spacing:0.02em;}
 
  /* ---------- CTA ---------- */
  .cta{background:var(--ink);padding:110px 0;text-align:center;position:relative;overflow:hidden;}
  .cta-road{position:absolute;bottom:40px;left:0;right:0;height:1px;background:rgba(255,255,255,0.1);}
  .cta h2{color:#fff;font-size:clamp(28px,4vw,42px);font-weight:700;letter-spacing:-0.02em;max-width:600px;margin:0 auto 18px;position:relative;z-index:2;}
  .cta p{color:rgba(255,255,255,0.6);font-size:16px;max-width:460px;margin:0 auto 34px;position:relative;z-index:2;}
  .cta-ctas{display:flex;gap:16px;justify-content:center;position:relative;z-index:2;}
 
  /* ---------- FOOTER ---------- */
  footer{background:var(--ink);border-top:1px solid rgba(255,255,255,0.08);padding:44px 0 0;}
  footer .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;}
  footer .foot-links{display:flex;gap:28px;}
  footer .foot-links a{font-size:13.5px;color:rgba(255,255,255,0.55);}
  footer .foot-links a:hover{color:#fff;}
  .social{display:flex;gap:16px;}
  .social a{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;transition:border-color .2s, background .2s, transform .2s;}
  .social a:hover{border-color:var(--teal-bright);background:rgba(63,217,190,0.1);transform:translateY(-2px);}
  footer .copyright{font-size:12.5px;color:rgba(255,255,255,0.35);padding:28px 0;}
  .foot-marquee{margin-top:36px;}
 
  @media (max-width:860px){
    nav.links{display:none;}
    .stats .wrap{grid-template-columns:1fr;gap:36px;}
    .product-row{grid-template-columns:1fr;gap:32px;}
    .product-row.reverse .art{order:1;}
    .product-row.reverse .copy{order:2;}
    .flow-steps{grid-template-columns:1fr;gap:40px;padding:0;}
    .flow-path{display:none;}
    .cta-ctas{flex-direction:column;align-items:center;}
    footer .wrap{flex-direction:column;align-items:flex-start;}
    .float-badge{display:none;}
    .logo-row{gap:28px;}
  }
</style>
</head>
<body>
 
<header id="siteHeader">
  <div class="wrap">
    <div class="wordmark">kt<span>telematics</span></div>
    <nav class="links">
      <a href="#products">Products</a>
      <a href="#convoy">Fleet</a>
      <a href="#how">How it works</a>
      <a href="#contact">Contact</a>
    </nav>
    <a href="#contact" class="btn btn-ghost">Sign in</a>
  </div>
</header>
 
<section class="hero">
  <div class="hero-bg-shape shape-1"></div>
  <div class="hero-bg-shape shape-2"></div>
 
  <div class="float-badge badge-a" id="badge-a">
    <svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="8" fill="#22B8A0"/><path d="M4.5 8.2L6.8 10.5L11.5 5.5" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
    Geofence alert cleared
  </div>
  <div class="float-badge badge-b" id="badge-b">
    <svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="none" stroke="#F2A93B" stroke-width="1.6"/><path d="M8 4.5V8L10.3 9.6" stroke="#F2A93B" stroke-width="1.6" stroke-linecap="round"/></svg>
    Tyre pressure normal · 32 PSI
  </div>
  <div class="float-badge badge-c" id="badge-c">
    <svg width="16" height="16" viewBox="0 0 16 16"><path d="M8 2C5.2 2 3 4.2 3 7c0 4 5 7 5 7s5-3 5-7c0-2.8-2.2-5-5-5Z" fill="#3FD9BE"/></svg>
    412 vehicles online
  </div>
 
  <div class="wrap">
    <div class="hero-tag"><span class="dot"></span>LIVE ACROSS 12,000+ VEHICLES</div>
    <h1 id="hero-h1">
      <span class="line"><span>Track every vehicle.</span></span>
      <span class="line"><span>Sense every tyre.</span></span>
    </h1>
    <p class="sub" id="hero-sub">One platform for fleet location, driver behaviour and real-time tyre pressure — built for operators who can't afford blind spots.</p>
    <div class="hero-ctas" id="hero-ctas">
      <a href="#contact" class="btn btn-solid">Talk to sales</a>
      <a href="#products" class="btn btn-ghost">See the platform</a>
    </div>
  </div>
 
  <div class="road-stage wrap">
    <div class="road-line"></div>
    <div class="road-dashes" id="road-dashes"></div>
 
    <!-- faint background vehicles for depth -->
    <svg class="bg-vehicle" id="bgVan" style="left:12%;" width="90" height="46" viewBox="0 0 90 46">
      <rect x="4" y="10" width="66" height="26" rx="5" fill="#3FD9BE"/>
      <path d="M70 16H82L86 26V36H70V16Z" fill="#3FD9BE"/>
      <circle cx="20" cy="38" r="7" fill="#0B1F2A"/>
      <circle cx="72" cy="38" r="7" fill="#0B1F2A"/>
    </svg>
    <svg class="bg-vehicle" id="bgCar" style="left:55%;" width="70" height="34" viewBox="0 0 70 34">
      <path d="M4 24C4 24 8 12 20 10H50C60 10 66 18 66 24V26H4V24Z" fill="#3FD9BE"/>
      <path d="M22 10L27 2H45L52 10Z" fill="#0B1F2A" opacity="0.3"/>
      <circle cx="18" cy="27" r="6" fill="#0B1F2A"/>
      <circle cx="54" cy="27" r="6" fill="#0B1F2A"/>
    </svg>
 
    <!-- main hero truck -->
    <svg id="truck" viewBox="0 0 230 110" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="0" y="20" width="150" height="58" rx="4" fill="#173B4C"/>
      <rect x="0" y="20" width="150" height="10" rx="3" fill="#1F4B60"/>
      <line x1="30" y1="20" x2="30" y2="78" stroke="#0B1F2A" stroke-width="1.5" opacity="0.4"/>
      <line x1="60" y1="20" x2="60" y2="78" stroke="#0B1F2A" stroke-width="1.5" opacity="0.4"/>
      <line x1="90" y1="20" x2="90" y2="78" stroke="#0B1F2A" stroke-width="1.5" opacity="0.4"/>
      <line x1="120" y1="20" x2="120" y2="78" stroke="#0B1F2A" stroke-width="1.5" opacity="0.4"/>
      <path d="M150 78V38C150 35 152 33 155 33H178L200 52V78H150Z" fill="#22B8A0"/>
      <path d="M178 33L200 52H181C179 52 178 50.5 178 49V33Z" fill="#0B1F2A" opacity="0.25"/>
      <rect x="152" y="58" width="46" height="4" fill="#0E2530" opacity="0.3"/>
      <rect x="198" y="68" width="8" height="10" rx="2" fill="#0E2530"/>
      <circle id="truck-pulse" cx="75" cy="10" r="4" fill="#3FD9BE"/>
      <g class="wheel" id="wheel1" transform="translate(35,90)">
        <circle r="15" fill="#0E2530"/><circle r="6.5" fill="#3FD9BE" opacity="0.85"/>
        <line x1="-11" y1="0" x2="11" y2="0" stroke="#0E2530" stroke-width="3"/>
        <line x1="0" y1="-11" x2="0" y2="11" stroke="#0E2530" stroke-width="3"/>
      </g>
      <g class="wheel" id="wheel2" transform="translate(105,90)">
        <circle r="15" fill="#0E2530"/><circle r="6.5" fill="#3FD9BE" opacity="0.85"/>
        <line x1="-11" y1="0" x2="11" y2="0" stroke="#0E2530" stroke-width="3"/>
        <line x1="0" y1="-11" x2="0" y2="11" stroke="#0E2530" stroke-width="3"/>
      </g>
      <g class="wheel" id="wheel3" transform="translate(178,90)">
        <circle r="15" fill="#0E2530"/><circle r="6.5" fill="#3FD9BE" opacity="0.85"/>
        <line x1="-11" y1="0" x2="11" y2="0" stroke="#0E2530" stroke-width="3"/>
        <line x1="0" y1="-11" x2="0" y2="11" stroke="#0E2530" stroke-width="3"/>
      </g>
    </svg>
  </div>
</section>
 
<!-- MARQUEE TICKER -->
<div class="marquee">
  <div class="marquee-track" id="marquee1">
    <!-- content duplicated by JS for seamless loop -->
    <div class="marquee-set" style="display:flex;">
