<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
gsap.registerPlugin(ScrollTrigger);
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 
/* split hero headline into words */
document.querySelectorAll('#hero-h1 .line span').forEach(el=>{
  const words = el.textContent.split(' ');
  el.innerHTML = words.map(w=>`<span class="word" style="display:inline-block;">${w}&nbsp;</span>`).join('');
});
 
/* duplicate marquee content for seamless infinite loop */
['marquee1','marquee2'].forEach(id=>{
  const track = document.getElementById(id);
  track.innerHTML += track.innerHTML;
});
 
/* header solidify on scroll */
const header = document.getElementById('siteHeader');
window.addEventListener('scroll', ()=> header.classList.toggle('solid', window.scrollY > 40));
 
if(!reduced){
 
  /* ---- HERO LOAD TIMELINE ---- */
  const tl = gsap.timeline({defaults:{ease:'power3.out'}});
  tl.set('.word', {yPercent:120, opacity:0})
    .set('#hero-sub, #hero-ctas', {opacity:0, y:16})
    .set('.road-line, .road-dashes', {opacity:0})
    .set('.float-badge', {opacity:0, y:10})
    .set('#bgVan, #bgCar', {opacity:0})
 
    .to('#truck', {x: () => (document.querySelector('.road-stage').offsetWidth/2) + 40, duration:1.7, ease:'power2.out'}, 0)
    .to('.road-line, .road-dashes', {opacity:1, duration:0.6}, 0)
    .to(['#wheel1','#wheel2','#wheel3'], {rotation:520, transformOrigin:'center', duration:1.7, ease:'power2.out'}, 0)
    .fromTo('#truck-pulse', {scale:0.6, opacity:0.4}, {scale:1.6, opacity:0, duration:1, repeat:2, ease:'sine.out'}, 0.3)
    .to('#bgVan', {opacity:0.16, x:40, duration:1.4}, 0.2)
    .to('#bgCar', {opacity:0.16, x:-30, duration:1.4}, 0.4)
 
    .to('.word', {yPercent:0, opacity:1, duration:0.7, stagger:0.045}, 0.9)
    .to('#hero-sub', {opacity:1, y:0, duration:0.6}, 1.35)
    .to('#hero-ctas', {opacity:1, y:0, duration:0.6}, 1.5)
    .to('.float-badge', {opacity:1, y:0, duration:0.6, stagger:0.15}, 1.7);
 
  // idle wheel roll + background vehicle drift after arrival
  gsap.to(['#wheel1','#wheel2','#wheel3'], {rotation:'+=360', duration:6, ease:'none', repeat:-1, delay:1.9});
  gsap.to('#bgVan', {x:'+=60', duration:9, ease:'sine.inOut', yoyo:true, repeat:-1, delay:2});
  gsap.to('#bgCar', {x:'-=50', duration:7, ease:'sine.inOut', yoyo:true, repeat:-1, delay:2});
  gsap.to('.road-dashes', {backgroundPositionX:'-160px', duration:3, ease:'none', repeat:-1});
 
  // floating badges gently bob
  gsap.to('#badge-a', {y:'+=10', duration:3.2, ease:'sine.inOut', yoyo:true, repeat:-1, delay:2.2});
  gsap.to('#badge-b', {y:'-=8', duration:2.6, ease:'sine.inOut', yoyo:true, repeat:-1, delay:2.5});
  gsap.to('#badge-c', {y:'+=8', duration:3.6, ease:'sine.inOut', yoyo:true, repeat:-1, delay:2.8});
 
  // mouse parallax on hero shapes
  document.querySelector('.hero').addEventListener('mousemove', (e)=>{
    const x = (e.clientX / window.innerWidth - 0.5);
    const y = (e.clientY / window.innerHeight - 0.5);
    gsap.to('.shape-1', {x: x*40, y: y*30, duration:1, ease:'power2.out'});
    gsap.to('.shape-2', {x: -x*30, y: -y*20, duration:1, ease:'power2.out'});
  });
 
  /* ---- MARQUEE INFINITE SCROLL ---- */
  document.querySelectorAll('.marquee-track').forEach(track=>{
    const width = track.scrollWidth / 2;
    gsap.to(track, {x: -width, duration: width/40, ease:'none', repeat:-1});
  });
 
  /* ---- STAT COUNTERS + GAUGE RINGS ---- */
  document.querySelectorAll('.stat-card').forEach((card,i)=>{
    const el = card.querySelector('.stat-num');
    const gauge = card.querySelector('circle[id^="gauge"]');
    const end = parseFloat(el.dataset.count);
    const decimals = parseInt(el.dataset.decimal || '0');
    let obj = {val:0};
    ScrollTrigger.create({
      trigger: card, start:'top 85%', once:true,
      onEnter:()=>{
        gsap.to(obj, {
          val:end, duration:1.6, ease:'power2.out',
          onUpdate:()=> el.textContent = decimals ? obj.val.toFixed(decimals) : Math.round(obj.val).toLocaleString()
        });
        gsap.to(gauge, {strokeDashoffset: 188.5 * (1 - 0.8), duration:1.6, ease:'power2.out'});
      }
    });
  });
 
  /* ---- CONVOY PINNED SCENE ---- */
  const convoyTl = gsap.timeline({
    scrollTrigger:{
      trigger:'.convoy-pin', start:'top top', end:'+=2200', scrub:0.6, pin:true
    }
  });
  gsap.set(['#cw1','#cw2','#cw3','#cw4'], {opacity:0, y:20});
  gsap.set('#cw1', {opacity:1, y:0});
 
  convoyTl
    .to('#farCar', {left:'115%', duration:3, ease:'none'}, 0)
    .to('#farVan', {left:'-15%', duration:3.4, ease:'none'}, 0)
    .to('#midVan', {left:'115%', duration:2.6, ease:'none'}, 0)
    .to('#nearLorry', {left:'115%', duration:2.2, ease:'none'}, 0)
    // heading crossfades as the convoy passes
    .to('#cw1', {opacity:0, y:-20, duration:0.4}, 0.35)
    .to('#cw2', {opacity:1, y:0, duration:0.4}, 0.35)
    .to('#cw2', {opacity:0, y:-20, duration:0.4}, 0.62)
    .to('#cw3', {opacity:1, y:0, duration:0.4}, 0.62)
    .to('#cw3', {opacity:0, y:-20, duration:0.4}, 0.85)
    .to('#cw4', {opacity:1, y:0, duration:0.4}, 0.85)
    .to(['#nearLorry .wheel', '#midVan .wheel'], {rotation:'+=900', transformOrigin:'center', duration:2.6, ease:'none'}, 0);
 
  /* ---- PRODUCT PANELS ---- */
  gsap.utils.toArray('.product-row').forEach(row=>{
    gsap.from(row.querySelector('.copy'), {opacity:0, y:24, duration:0.8, ease:'power2.out', scrollTrigger:{trigger:row, start:'top 78%'}});
    gsap.from(row.querySelector('.art'), {opacity:0, y:24, duration:0.8, delay:0.1, ease:'power2.out', scrollTrigger:{trigger:row, start:'top 78%'}});
  });
 
  // animated route dot travelling the map path in AssetTracker art
  const routePath = document.getElementById('routePath');
  const routeDot = document.getElementById('routeDot');
  const pathLen = routePath.getTotalLength();
  gsap.to({}, {
    duration:5, repeat:-1, ease:'sine.inOut',
    onUpdate: function(){
      const p = this.progress();
      const pt = routePath.getPointAtLength(p * pathLen);
      routeDot.setAttribute('cx', pt.x); routeDot.setAttribute('cy', pt.y);
    }
  });
  gsap.to('.pin', {y:'-=6', duration:1.6, ease:'sine.inOut', yoyo:true, repeat:-1, stagger:0.3});
 
  // tyre ring spin + pressure gauge sweep
  gsap.to('#tyre-spin', {rotation:360, transformOrigin:'90px 90px', duration:14, repeat:-1, ease:'none'});
  ScrollTrigger.create({
    trigger:'#art-tyre', start:'top 75%', once:true,
    onEnter:()=>{
      gsap.to('#pressureArc', {strokeDashoffset:123*0.28, duration:1.4, ease:'power2.out'});
      gsap.to('#needle', {rotation:65, duration:1.4, ease:'power2.out', transformOrigin:'45px 46px'});
    }
  });
 
  /* ---- FLOW: vehicle travels Sense -> Stream -> See ---- */
  const flowSection = document.querySelector('.flow');
  const steps = ['#step1','#step2','#step3'];
  ScrollTrigger.create({
    trigger: flowSection, start:'top 60%', end:'bottom 70%', scrub:0.6,
    onUpdate: self => {
      const p = self.progress;
      document.getElementById('flow-fill').style.width = (p*100)+'%';
      const track = document.querySelector('.flow-path');
      const w = track.offsetWidth;
      document.getElementById('flow-vehicle').style.left = (p*w)+'px';
      steps.forEach((s,i)=>{ document.querySelector(s).classList.toggle('active', p >= i/2 - 0.02); });
    }
  });
 
} else {
  document.querySelectorAll('.word').forEach(w=> w.style.opacity = 1);
  document.getElementById('hero-sub').style.opacity = 1;
  document.getElementById('hero-ctas').style.opacity = 1;
  document.querySelectorAll('.float-badge').forEach(b=> b.style.opacity = 1);
  document.querySelector('.road-line').style.opacity = 1;
  document.querySelector('.road-dashes').style.opacity = 1;
  document.getElementById('truck').style.left = '30%';
  document.querySelectorAll('.stat-num').forEach(el=>{
    const end = parseFloat(el.dataset.count);
    const decimals = parseInt(el.dataset.decimal || '0');
    el.textContent = decimals ? end.toFixed(decimals) : Math.round(end).toLocaleString();
  });
  document.querySelectorAll('circle[id^="gauge"]').forEach(g=> g.setAttribute('stroke-dashoffset', 188.5*0.2));
  document.querySelectorAll('#cw1').forEach(w=> w.style.opacity = 1);
}
</script>
</body>
</html>
 
